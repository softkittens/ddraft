# Local only. Never commit a real key. The agent server reads these; the browser never sees them.
# Fill any combination. Chat lists only the providers that have a key.

# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
VERCEL_API_KEY=
# VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1

# OpenCode Go — https://opencode.ai/auth  (Bearer key, OpenAI-compatible /v1/chat/completions)
OPENCODE_GO_API_KEY=
# OPENCODE_API_KEY=          # accepted as an alias
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# xAI — https://console.x.ai/
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# Qwen Model Studio — https://modelstudio.console.alibabacloud.com/  (DashScope OpenAI-compatible)
DASHSCOPE_API_KEY=
# QWEN_API_KEY=              # accepted as an alias
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

PEN_AGENT_PORT=3001
