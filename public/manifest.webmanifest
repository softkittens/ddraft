{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/",
  "name": "ddraft",
  "short_name": "ddraft",
  "description": "Fast, fluid design canvas and drafting studio with agent pair programming",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#171717",
  "theme_color": "#171717",
  "orientation": "any",
  "categories": ["design", "productivity", "graphics", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg?v=3",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Canvas",
      "url": "/?action=new",
      "description": "Start a fresh design canvas",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
